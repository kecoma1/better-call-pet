{
  "name": "better-call-pet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:tools": "vitest run --config vitest.tools.config.ts",
    "test:tools:live": "vitest run --config vitest.tools-live.config.ts",
    "test:e2e": "playwright test",
    "test:voice:live": "node --env-file=.env node_modules/vitest/vitest.mjs run --config qa/voice.vitest.config.ts",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm test && npm run build && npm --prefix functions run build",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bcp-chat \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "firebase": "^13.0.0",
    "lucide-react": "^0.552.0",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
